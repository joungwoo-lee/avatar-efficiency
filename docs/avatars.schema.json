{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joungwoo-lee/avatar-efficiency/docs/avatars.schema.json",
  "title": "avatar-efficiency provider document (schemaVer 1)",
  "type": "object",
  "required": ["schemaVer", "avatars"],
  "additionalProperties": true,
  "properties": {
    "schemaVer": { "const": 1 },
    "avatars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["avatarId", "loginId", "script", "roles"],
        "additionalProperties": true,
        "properties": {
          "avatarId": { "type": "string", "minLength": 1 },
          "loginId": { "type": "string", "minLength": 1 },
          "script": { "type": "string", "minLength": 1 },
          "costAllocation": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "amount": { "type": "number", "minimum": 0 },
              "currency": { "type": "string" },
              "share": { "type": "number", "minimum": 0, "maximum": 1 },
              "plannedHours": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "weight", "script", "tasks"],
              "additionalProperties": true,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "name": { "type": "string", "minLength": 1 },
                "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "script": { "type": "string", "minLength": 1 },
                "tasks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["id", "name", "weight", "script"],
                    "additionalProperties": true,
                    "properties": {
                      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                      "name": { "type": "string", "minLength": 1 },
                      "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                      "script": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
