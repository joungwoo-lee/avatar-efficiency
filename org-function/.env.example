# 원본 SSOT DB 접속 정보
SSOT_DB_IP=""
SSOT_DB_PORT=""
SSOT_DB_DBNAME=""
SSOT_DB_ID=""
SSOT_DB_PW=""

# SQLAlchemy dialect (기본 mysql+pymysql, PostgreSQL이면 postgresql+psycopg2)
SSOT_DB_DIALECT="mysql+pymysql"

# 원본 테이블명 기본값 (build 호출 시 인자로 덮어쓰기 가능)
SSOT_DB_TABLE="org_master"

# 열 이름 기본값 = 원본 테이블 스키마의 실제 열 이름 (SHOW COLUMNS 로 확인,
# build 호출 시 columns 인자로 덮어쓰기 가능)
SSOT_COL_TEAM="팀"
SSOT_COL_GROUP="그룹"
SSOT_COL_PART="파트"
SSOT_COL_FUNC1="Function1"
SSOT_COL_FUNC2="Function2"
